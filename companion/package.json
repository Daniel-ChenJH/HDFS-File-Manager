{
  "name": "hdfs-file-manager-local",
  "displayName": "HDFS File Manager Local Transfer",
  "description": "Use files on your computer when HDFS File Manager runs over Remote SSH.",
  "version": "0.1.0",
  "publisher": "daniel-chenjh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Daniel-ChenJH/HDFS-File-Manager.git"
  },
  "homepage": "https://github.com/Daniel-ChenJH/HDFS-File-Manager",
  "bugs": {
    "url": "https://github.com/Daniel-ChenJH/HDFS-File-Manager/issues"
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "extensionKind": [
    "ui"
  ],
  "api": "none",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:_hdfsFileManager.remoteLabel",
    "onCommand:_hdfsFileManager.localTransfer",
    "onCommand:_hdfsFileManager.files",
    "onCommand:_hdfsFileManager.reveal"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  }
}
